{
  "name": "log-file-write",
  "version": "2.2.0",
  "description": "A lightweight, timezone-aware Node.js file logger with optional Slack notifications.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf lib coverage",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thisara-Yashoda/log-file-write.git"
  },
  "author": "thisarahetz <thisarayashodagcc@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Thisara-Yashoda/log-file-write/issues"
  },
  "homepage": "https://github.com/Thisara-Yashoda/log-file-write#readme",
  "dependencies": {
    "dayjs": "^1.11.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.9.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  },
  "files": [
    "lib/**/*"
  ],
  "keywords": [
    "logger",
    "node",
    "file-logger",
    "slack",
    "typescript"
  ]
}
